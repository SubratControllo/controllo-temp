# Optional public endpoint that receives demo-request JSON.
# When empty, the browser simulates a successful submission.
VITE_LEAD_ENDPOINT=

# Optional public booking URL shown after a successful demo request.
VITE_DEMO_CALENDAR_URL=

# Optional public absolute HTTP(S) URL for the externally owned trial flow.
# When empty or invalid, Start Free Trial links fall back to /pricing.
VITE_TRIAL_URL=
